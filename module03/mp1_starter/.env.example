# Copy to .env (never commit it) - mp1_setup.py does this for you and fills in the first two lines.
API_KEY=paste_your_groq_key_here          # used ONLY by the gateway container - the app never sees it
LITELLM_MASTER_KEY=sk-mp1-change-me       # the key your app sends to the gateway (mp1_setup.py makes a random one)

GATEWAY_URL=http://localhost:4000         # for local runs; docker-compose.yml sets http://litellm:4000 for the app
MODEL=shopassist                          # a MODEL GROUP in gateway/config.yaml, not a provider model

# Memory (app/memory.py). Leave blank for the defaults in the code.
MEMORY=
KEEP_TURNS=
