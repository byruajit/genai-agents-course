# Copy this file to .env and paste your key. .env is git-ignored and never uploaded.
# Never put a key in chat, code, or a screenshot.

# --- Groq (default for the course) ---
BASE_URL=https://api.groq.com/openai/v1
API_KEY=paste_your_groq_key_here
MODEL=openai/gpt-oss-20b          # pinned for the batch; the instructor changes this, not you

# --- Ollama fallback (local, private). Uncomment these three, comment the three above. ---
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=llama3.2:3b
